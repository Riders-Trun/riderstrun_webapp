# Base URL of the backend API.
# Leave EMPTY in development: vite.config.ts proxies /api to localhost:3000, which
# keeps the browser same-origin so the httpOnly refreshToken cookie is sent.
# Set it in production only if the API lives on another host — that makes requests
# cross-site, so the API must also set CORS_ORIGIN to this app's origin.
VITE_API_URL=

# Data source. Defaults to mock data; set to "false" to talk to the real backend.
# With mock data the app runs standalone — no API or database required.
VITE_USE_MOCK=true
